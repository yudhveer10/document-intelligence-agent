# API
PORT=4000
CORS_ORIGIN=http://localhost:5173
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=10

# Supabase. Keep the service-role key on the backend only.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Web build-time public value. This is an API base URL, not a secret.
VITE_API_URL=http://localhost:4000/api
